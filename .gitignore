# OS
.DS_Store
Thumbs.db
*.swp
*~

# Editor
.idea/
.vscode/*
!.vscode/mcp.json
!.vscode/extensions.json
*.code-workspace

# Logs e temporarios
*.log
*.tmp
*.bak
*.orig

# Saidas geradas
/dist/
/build/
/out/

# Saidas de tools (dados de exemplo nao devem ir ao repo)
/tools/*/output/
/tools/forms-extractor/output/

# Snapshots locais antes de upload via MCP (evita versionar binarios temporarios)
/.specs/snapshots/
*.snapshot.zip

# Rascunhos de spec ainda nao aprovados
/.specs/draft/

# Copia de prompts para .github/prompts/ (path default do VS Code Chat).
# Os canonicos ficam em /prompts/. Esta pasta e gerada localmente para
# habilitar autocomplete de slash-commands no Copilot Chat.
/.github/prompts/

# Workspace local - avaliacoes, reviews, customizacoes e materiais de uso
# interno do tech lead durante o piloto. Nao vai para o repo.
/workspace/


# Credenciais - NUNCA commitar
.env
.env.local
*.pat
*.token
secrets/

# Arquivos do MCP local com PAT inline
.vscode/mcp.local.json

# Config local do Claude Code (pessoal de cada maquina)
.claude/settings.local.json
